{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Teahouse",
  "version": "0.3.1",
  "identifier": "io.github.linyeir.teahouse",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @teahouse/client dev",
    "beforeBuildCommand": "pnpm --filter @teahouse/client build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teahouse",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "AI roleplay in the style of a visual novel",
    "license": "AGPL-3.0-only"
  }
}
